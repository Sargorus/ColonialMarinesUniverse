<controls:ResearchDocumentWriteWindow xmlns="https://spacestation14.io"
                                           xmlns:controls="clr-namespace:Content.Client.CMU14.Chemistry.Research"
                                           Title="{Loc 'cmu-research-documents-write-title'}"
                                           MinSize="540 420">
    <BoxContainer Orientation="Vertical" SeparationOverride="6" Margin="10">
        <Label Text="{Loc 'cmu-research-documents-title-label'}" />
        <LineEdit Name="TitleEdit" Access="Public" />
        <Label Text="{Loc 'cmu-research-documents-type-label'}" />
        <OptionButton Name="TypeOption" Access="Public" />
        <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
            <BoxContainer Name="Facts" Access="Public" Orientation="Vertical"
                          SeparationOverride="4" VerticalExpand="True" />
        </ScrollContainer>
        <Button Name="Write" Access="Public" Text="{Loc 'cmu-research-documents-write'}" />
    </BoxContainer>
</controls:ResearchDocumentWriteWindow>
